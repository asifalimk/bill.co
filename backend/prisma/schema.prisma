generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum PaymentType {
  CASH
  CREDIT
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(64)
  password_hash String
  name          String
  role          UserRole @default(CASHIER)
  created_at    DateTime @default(now())
}

model Item {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(3)
  name            String
  category        String
  unit            String
  purchase_price  Decimal  @db.Decimal(12, 2)
  selling_price   Decimal  @db.Decimal(12, 2)
  stock_qty       Int      @default(0)
  min_stock_level Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  invoiceItems  InvoiceItem[]
  purchaseItems PurchaseItem[]

  @@index([code], name: "idx_item_code")
}

model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String   @unique
  address        String?
  gstin          String?
  credit_balance Decimal  @default(0) @db.Decimal(12, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  invoices Invoice[]

  @@index([phone], name: "idx_customer_phone")
}

model Vendor {
  id           Int      @id @default(autoincrement())
  name         String
  company_name String
  phone        String
  email        String?
  address      String?
  gstin        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id            Int            @id @default(autoincrement())
  vendor_id     Int
  invoice_no    String
  purchase_date DateTime       @default(now())
  notes         String?
  total_amount  Decimal        @default(0) @db.Decimal(12, 2)
  vendor        Vendor         @relation(fields: [vendor_id], references: [id])
  lines         PurchaseItem[]

  @@index([vendor_id])
  @@index([invoice_no])
}

model PurchaseItem {
  id            Int      @id @default(autoincrement())
  purchase_id   Int
  item_id       Int
  quantity      Int
  unit_cost     Decimal  @db.Decimal(12, 2)
  selling_price Decimal  @db.Decimal(12, 2)
  line_total    Decimal  @db.Decimal(12, 2)
  created_at    DateTime @default(now())

  purchase Purchase @relation(fields: [purchase_id], references: [id])
  item     Item     @relation(fields: [item_id], references: [id])

  @@index([purchase_id])
  @@index([item_id])
}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoice_no      String        @unique
  customer_id     Int?
  customer_name   String        @default("")
  customer_phone  String        @default("")
  customer_gstin  String?
  cashier_name    String        @default("")
  payment_type    PaymentType
  site_note       String?
  gross_amount    Decimal       @db.Decimal(12, 2)
  bill_discount   Decimal       @default(0) @db.Decimal(12, 2)
  total_discounts Decimal       @db.Decimal(12, 2)
  total_cost      Decimal       @db.Decimal(12, 2)
  net_amount      Decimal       @db.Decimal(12, 2)
  net_profit      Decimal       @db.Decimal(12, 2)
  is_edited       Boolean       @default(false)
  edited_at       DateTime?
  created_at      DateTime      @default(now())
  customer        Customer?     @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  items           InvoiceItem[]

  @@index([created_at])
  @@index([customer_id])
}

model InvoiceItem {
  id              Int      @id @default(autoincrement())
  invoice_id      Int
  item_id         Int
  code            String
  name            String
  category        String
  unit            String
  quantity        Int
  purchase_price  Decimal  @db.Decimal(12, 2)
  selling_price   Decimal  @db.Decimal(12, 2)
  line_discount   Decimal  @db.Decimal(12, 2)
  line_total      Decimal  @db.Decimal(12, 2)
  line_net_profit Decimal  @db.Decimal(12, 2)
  created_at      DateTime @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [item_id], references: [id])

  @@index([invoice_id])
  @@index([item_id])
}

model CompanyProfile {
  id                   Int      @id @default(autoincrement())
  store_name           String
  tagline              String
  phone_primary        String
  address_line1        String
  city                 String
  state                String
  pincode              String
  gstin                String
  terms_and_conditions String
  short_name           String   @default("H")
  email                String   @default("")
  website              String   @default("")
  footer_note          String   @default("")
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}
